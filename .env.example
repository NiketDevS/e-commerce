# =============================================================================
# ENVIRONMENT VARIABLES — EXAMPLE CONFIGURATION
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (matches docker-compose.yml defaults)
# -----------------------------------------------------------------------------
POSTGRES_USER=support_user
POSTGRES_PASSWORD=support_password
POSTGRES_DB=ecommerce_support

# Prisma uses this for the main application database
DATABASE_URL=postgresql://support_user:support_password@localhost:5432/ecommerce_support

# Separate database for running automated tests (port 5433 in docker-compose)
DATABASE_URL_TEST=postgresql://support_user:support_password@localhost:5433/ecommerce_support_test

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# JWT — replace with a strong random secret in production (min 32 chars)
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# CORS — frontend origin
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Business Rules — Configurable Policy Values
# -----------------------------------------------------------------------------
# Return window in calendar days (from deliveryDate)
RETURN_WINDOW_DAYS=7

# Refund auto-approval limit in Indian Rupees (Decimal)
# Refunds above this require human review
REFUND_AUTO_APPROVE_LIMIT=5000

# -----------------------------------------------------------------------------
# AI Agent
# -----------------------------------------------------------------------------
# Set to 'mock' for deterministic testing (no API key required)
# Set to 'openai' or 'gemini' to use a real LLM (optional)
LLM_PROVIDER=mock

# Only required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only required when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
